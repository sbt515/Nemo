<Window x:Class="Nemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D&amp;D 5e Character Creator"
        Height="980"
        Width="1480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- Selected Tab Style (Blue) -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="#333"
                                BorderBrush="#444"
                                BorderThickness="1,1,1,0"
                                Padding="12,6">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#3A7CA5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ComboBox / ComboBoxItem global styles live in App.xaml (full item template). -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="White"/>
        </Style>
        <!-- Force all TextBlock labels to be white -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="White"/>
        </Style>
        <!-- DataGrid Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#2A2A2A"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="8,4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="MainTabControl"
                    Margin="8"
                    Background="#252525"
                    BorderBrush="#444"
                    SelectedIndex="0">

            <!-- TAB 1: BASIC INFO -->
            <TabItem Header="1. Basic Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="25"
                            MaxWidth="640">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,18">
                        <Button Content="📂 Load Character"
                                Click="LoadCharacter_Click"
                                Width="190"
                                Height="42"
                                Style="{StaticResource Nemo.Button.Success}"
                                HorizontalAlignment="Left"
                                Margin="0,0,12,0"/>
                    </StackPanel>

                    <!-- QUICK GENERATE: themed templates + random -->
                    <Border Background="#2A2A2A"
                            BorderBrush="#3A7CA5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="⚡ QUICK GENERATE"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#7CFC00"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Build a complete character from themed templates or pure randomness. Optimized &amp; General: pick a build, then L1/3/5/8. Random: set target level below. Custom keeps saved level and multiclass."
                                       FontSize="12"
                                       Foreground="#AAA"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="CATEGORY"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>
                                <TextBlock Grid.Column="2"
                                           Text="ROLE / STYLE"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblTemplateRandomLevel"
                                           Grid.Column="4"
                                           Text="LEVEL"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Margin="0,0,0,4"
                                           Visibility="Collapsed"/>

                                <ComboBox x:Name="cmbTemplateCategory"
                                          Grid.Row="1"
                                          Height="34"
                                          FontSize="14"
                                          Background="#1E1E1E"
                                          Foreground="#F0F0F0"
                                          BorderBrush="#555"
                                          Padding="8,4"
                                          SelectionChanged="cmbTemplateCategory_SelectionChanged"/>
                                <ComboBox x:Name="cmbTemplateRole"
                                          Grid.Row="1"
                                          Grid.Column="2"
                                          Height="34"
                                          FontSize="14"
                                          Background="#1E1E1E"
                                          Foreground="#F0F0F0"
                                          BorderBrush="#555"
                                          Padding="8,4"
                                          SelectionChanged="cmbTemplateRole_SelectionChanged"/>
                                <ComboBox x:Name="cmbTemplateRandomLevel"
                                          Grid.Row="1"
                                          Grid.Column="4"
                                          Width="72"
                                          Height="34"
                                          FontSize="14"
                                          Background="#1E1E1E"
                                          Foreground="#F0F0F0"
                                          BorderBrush="#555"
                                          Padding="8,4"
                                          Visibility="Collapsed"
                                          ToolTip="Target character level for Random / True Random generation (1–20)"
                                          SelectionChanged="cmbTemplateRandomLevel_SelectionChanged"/>
                            </Grid>

                            <TextBlock x:Name="txtTemplateHint"
                                       Text=""
                                       FontSize="12"
                                       Foreground="#BBB"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,12"
                                       LineHeight="17"/>

                            <Button x:Name="btnGenerateCharacter"
                                    Content="🎲 Generate Character"
                                    Click="GenerateCharacter_Click"
                                    Height="40"
                                    Style="{StaticResource Nemo.Button.Primary}"
                                    HorizontalAlignment="Left"
                                    Padding="16,0"
                                    MinWidth="200"/>

                            <TextBlock x:Name="txtGenerateResult"
                                       Text=""
                                       FontSize="12"
                                       Foreground="#8FDF8F"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CHARACTER NAME"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtCharacterName"
                             Height="32"
                             FontSize="16"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#555"
                             Padding="8,4"/>

                    <TextBlock Text="PLAYER NAME"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,18,0,6"/>
                    <TextBox x:Name="txtPlayerName"
                             Height="32"
                             FontSize="16"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#555"
                             Padding="8,4"/>

                    <TextBlock Text="AVATAR / PORTRAIT (optional)"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,10,0,8"/>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Upload Button -->
                        <Button x:Name="btnUploadAvatar"
                                Content="📤 Upload Image"
                                Width="140"
                                Height="36"
                                Style="{StaticResource Nemo.Button.Success}"
                                Click="UploadAvatar_Click"
                                Margin="0,0,20,0"/>

                        <!-- Avatar Preview - Rounded Square (Reliable) -->
                        <Border x:Name="brdAvatarPreview"
                                Width="300"
                                Height="300"
                                BorderBrush="White"
                                BorderThickness="3"
                                Background="#1E1E1E"
                                CornerRadius="16"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Image x:Name="imgAvatar"
                                   Width="290"
                                   Height="290"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                    </StackPanel>

                    <!-- Status -->
                    <TextBlock x:Name="lblAvatarStatus"
                               Text=""
                               Foreground="#888888"
                               FontSize="12"
                               Margin="0,8,0,0"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: RACE -->
            <TabItem Header="2. Race">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="RACE CATEGORY"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbRaceCategory"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  SelectionChanged="cmbRaceCategory_SelectionChanged"/>
                        <TextBlock Text="Common · Exotic · Monstrous (dnd5e.wikidot.com)"
                                   FontSize="11"
                                   Foreground="#888"
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="SELECT RACE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbRace"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  SelectionChanged="cmbRace_SelectionChanged"/>
                        <TextBlock Text="SUBRACE (if applicable)"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,16,0,6"
                                   Foreground="#CCC"/>

                        <ComboBox x:Name="cmbSubrace"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  SelectionChanged="cmbSubrace_SelectionChanged"
                                  IsEnabled="False"/>

                        <StackPanel x:Name="pnlFlexibleBonuses"
                                    Visibility="Collapsed"
                                    Margin="0,12,0,0">
                            <TextBlock x:Name="lblFlexibleBonusesHeader"
                                       Text="CHOOSE FLEXIBLE RACIAL BONUSES"
                                       FontWeight="Bold"
                                       Foreground="#CCC"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="cmbFlexibleBonus1"
                                          Height="32"
                                          Margin="0,0,6,0"
                                          Background="#2A2A2A"
                                          Foreground="#F0F0F0"/>
                                <ComboBox x:Name="cmbFlexibleBonus2"
                                          Height="32"
                                          Grid.Column="1"
                                          Background="#2A2A2A"
                                          Foreground="#F0F0F0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="pnlRaceSkillChoice"
                                    Visibility="Collapsed"
                                    Margin="0,15,0,0">
                            <TextBlock x:Name="lblRaceSkillHeader"
                                       Text="CUSTOM LINEAGE CHOICES"
                                       Foreground="#7CFC00"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>

                            <RadioButton x:Name="rbRaceDarkvision"
                                         Content="Darkvision (60 ft)"
                                         GroupName="CustomLineage"
                                         Checked="RaceSkillChoice_Changed"
                                         Foreground="White"/>

                            <RadioButton x:Name="rbRaceSkill"
                                         Content="Proficiency in one skill of your choice"
                                         GroupName="CustomLineage"
                                         Checked="RaceSkillChoice_Changed"
                                         Foreground="White"
                                         Margin="0,6,0,0"/>

                            <ComboBox x:Name="cmbRaceSkillChoice"
                                      Width="320"
                                      Margin="25,8,0,0"
                                      Visibility="Collapsed"
                                      SelectionChanged="RaceGrantedSkill_Changed"
                                      Background="#2A2A2A"
                                      Foreground="#F0F0F0"
                                      BorderBrush="#555"/>
                        </StackPanel>

                        <!-- HIGH ELF CANTRIP CHOICE -->
                        <StackPanel x:Name="pnlHighElfCantrip"
                                    Visibility="Collapsed"
                                    Margin="0,18,0,0">
                            <TextBlock Text="HIGH ELF CANTRIP"
                                       FontWeight="Bold"
                                       Foreground="#CCC"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbHighElfCantrip"
                                      Height="34"
                                      Background="#2A2A2A"
                                      Foreground="#F0F0F0"
                                      BorderBrush="#555"
                                      SelectionChanged="HighElfCantrip_SelectionChanged"/>
                        </StackPanel>

                        <!-- HIGH ELF CANTRIP PREVIEW (below race details) -->
                        <Border x:Name="pnlHighElfCantripPreview"
                                Grid.Column="1"
                                Margin="25,20,0,0"
                                Background="#1E1E1E"
                                BorderBrush="#7CFC00"
                                BorderThickness="1"
                                Padding="15"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="CANTRIP DETAILS"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#7CFC00"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtHighElfCantripPreview"
                                           Foreground="White"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Racial Ability Bonuses will be automatically applied to your stats."
                                   Foreground="#AAA"
                                   FontSize="12"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1"
                                  Margin="25,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtRaceDetails"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="19"
                                   Foreground="#DDD"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: BACKGROUND -->
            <TabItem Header="3. Background">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel>
                        <TextBlock Text="SELECT BACKGROUND"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbBackground"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  SelectionChanged="cmbBackground_SelectionChanged"/>

                        <!-- Language panel stays on left for consistency with Race skill choice -->
                        <StackPanel x:Name="pnlBackgroundLanguages"
                                    Margin="0,20,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="SELECT LANGUAGES"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbBackgroundLanguage1"
                                      Width="320"
                                      Height="32"
                                      FontSize="14"
                                      Background="#2A2A2A"
                                      Foreground="#F0F0F0"
                                      BorderBrush="#555"
                                      Margin="0,0,0,8"
                                      Visibility="Collapsed"/>
                            <ComboBox x:Name="cmbBackgroundLanguage2"
                                      Width="320"
                                      Height="32"
                                      FontSize="14"
                                      Background="#2A2A2A"
                                      Foreground="#F0F0F0"
                                      BorderBrush="#555"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Details -->
                    <ScrollViewer Grid.Column="1"
                                  Margin="25,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtBackgroundDetails"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="19"
                                   Foreground="#DDD"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 4: CLASS &amp; SUBCLASS -->
            <TabItem Header="4. Class &amp; Subclass">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SELECT CLASS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbClass"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  SelectionChanged="cmbClass_SelectionChanged"/>

                        <TextBlock Text="SUBCLASS"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,16,0,6"/>
                        <ComboBox x:Name="cmbSubclass"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  IsEnabled="False"/>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1"
                                  Margin="25,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <!-- Built in code: class stats, level-1 features always open,
                             higher-level class/subclass features in Expanders -->
                        <StackPanel x:Name="pnlClassDetails"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 5: ABILITY SCORES -->
            <TabItem Header="5. Ability Scores">
                <StackPanel Margin="25">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <TextBlock Text="STAT GENERATION METHOD:"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <RadioButton x:Name="rbPointBuy"
                                     Content="Point Buy (27 pts)"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="18,0,0,0"
                                     IsChecked="True"/>
                        <RadioButton x:Name="rbStandardArray"
                                     Content="Standard Array (15,14,13,12,10,8)"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="14,0,0,0"/>
                        <RadioButton x:Name="rbRoll4d6"
                                     Content="Roll 4d6 drop lowest"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="14,0,0,0"/>
                        <RadioButton x:Name="rbRoll3d6"
                                     Content="Roll 3d6 straight"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="14,0,0,0"/>
                        <RadioButton x:Name="rbCustom"
                                     Content="Custom (1-20)"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="14,0,0,0"/>
                    </StackPanel>

                    <Button x:Name="btnRollStats"
                            Content="🎲 ROLL STATS"
                            Width="170"
                            Height="36"
                            Click="btnRollStats_Click"
                            Style="{StaticResource Nemo.Button.Success}"
                            Margin="0,0,0,18"
                            Visibility="Collapsed"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <!-- Ability -->
                            <ColumnDefinition Width="120"/>
                            <!-- Base (+/- steppers) -->
                            <ColumnDefinition Width="70"/>
                            <!-- Racial -->
                            <ColumnDefinition Width="70"/>
                            <!-- Final -->
                            <ColumnDefinition Width="90"/>
                            <!-- Modifier -->
                            <ColumnDefinition Width="160"/>
                            <!-- Roll Breakdown -->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Ability"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>
                        <TextBlock Text="Base"
                                   Grid.Column="1"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>
                        <TextBlock Text="Racial"
                                   Grid.Column="2"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>
                        <TextBlock Text="Final"
                                   Grid.Column="3"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>
                        <TextBlock Text="Modifier"
                                   Grid.Column="4"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>

                        <!-- Strength -->
                        <TextBlock Text="Strength"
                                   Grid.Row="1"
                                   VerticalAlignment="Center"/>
                        <StackPanel x:Name="pnlStrBaseStepper"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="btnStrBaseDec"
                                    Content="−"
                                    Width="26"
                                    Height="26"
                                    Tag="Str"
                                    Click="PointBuyStat_Dec"
                                    ToolTip="Decrease base score"
                                    Style="{StaticResource Nemo.Button.Subtle}"
                                    FontSize="14"/>
                            <TextBox x:Name="txtStrBase"
                                     Width="42"
                                     Height="26"
                                     Margin="3,0"
                                     Text="8"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="#2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#555"
                                     TextChanged="Stat_TextChanged"
                                     LostFocus="Stat_LostFocus"/>
                            <Button x:Name="btnStrBaseInc"
                                    Content="+"
                                    Width="26"
                                    Height="26"
                                    Tag="Str"
                                    Click="PointBuyStat_Inc"
                                    ToolTip="Increase base score"
                                    Style="{StaticResource Nemo.Button.Subtle}"
                                    FontSize="14"/>
                        </StackPanel>
                        <TextBlock x:Name="lblStrRoll"
                                   Grid.Row="1"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStrRacial"
                                   Grid.Row="1"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStrFinal"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStrMod"
                                   Grid.Row="1"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Dexterity -->
                        <TextBlock Text="Dexterity"
                                   Grid.Row="2"
                                   VerticalAlignment="Center"/>
                        <StackPanel x:Name="pnlDexBaseStepper"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="btnDexBaseDec"
                                    Content="−"
                                    Width="26"
                                    Height="26"
                                    Tag="Dex"
                                    Click="PointBuyStat_Dec"
                                    ToolTip="Decrease base score"
                                    Style="{StaticResource Nemo.Button.Subtle}"
                                    FontSize="14"/>
                            <TextBox x:Name="txtDexBase"
                                     Width="42"
                                     Height="26"
                                     Margin="3,0"
                                     Text="8"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="#2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#555"
                                     TextChanged="Stat_TextChanged"
                                     LostFocus="Stat_LostFocus"/>
                            <Button x:Name="btnDexBaseInc"
                                    Content="+"
                                    Width="26"
                                    Height="26"
                                    Tag="Dex"
                                    Click="PointBuyStat_Inc"
                                    ToolTip="Increase base score"
                                    Style="{StaticResource Nemo.Button.Subtle}"
                                    FontSize="14"/>
                        </StackPanel>
                        <TextBlock x:Name="lblDexRoll"
                                   Grid.Row="2"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDexRacial"
                                   Grid.Row="2"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDexFinal"
                                   Grid.Row="2"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDexMod"
                                   Grid.Row="2"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Constitution -->
                        <TextBlock Text="Constitution"
                                   Grid.Row="3"
                                   VerticalAlignment="Center"/>
                        <StackPanel x:Name="pnlConBaseStepper"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
