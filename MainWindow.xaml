<Window x:Class="Nemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D&amp;D 5e Character Creator"
        Height="980"
        Width="1480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- Selected Tab Style (Blue) -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="#333"
                                BorderBrush="#444"
                                BorderThickness="1,1,1,0"
                                Padding="12,6">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#3A7CA5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ComboBox styling for dark theme -->
        <!-- ComboBox Styling -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="Black"/>
            <Setter Property="BorderBrush"
                    Value="#555"/>
            <Setter Property="BorderBrush"
                    Value="#555"/>
            <Setter Property="Padding"
                    Value="8,4"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#1E1E1E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#4A7C59"/>
                    <Setter Property="Foreground"
                            Value="#216891"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="White"/>
        </Style>
        <!-- Force all TextBlock labels to be white -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="White"/>
        </Style>
        <!-- DataGrid Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#2A2A2A"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="8,4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="MainTabControl"
                    Margin="8"
                    Background="#252525"
                    BorderBrush="#444"
                    SelectedIndex="0">

            <!-- TAB 1: BASIC INFO -->
            <TabItem Header="1. Basic Info">
                <StackPanel Margin="25"
                            MaxWidth="600">
                    <TextBlock Text="CHARACTER NAME"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtCharacterName"
                             Height="32"
                             FontSize="16"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#555"
                             Padding="8,4"/>

                    <TextBlock Text="PLAYER NAME"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,18,0,6"/>
                    <TextBox x:Name="txtPlayerName"
                             Height="32"
                             FontSize="16"
                             Background="#2A2A2A"
                             Foreground="White"
                             BorderBrush="#555"
                             Padding="8,4"/>

                    <TextBlock Text="AVATAR / PORTRAIT (optional)"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,10,0,8"/>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Upload Button -->
                        <Button x:Name="btnUploadAvatar"
                                Content="📤 Upload Image"
                                Width="140"
                                Height="36"
                                Background="#2E7D32"
                                Foreground="White"
                                Click="UploadAvatar_Click"
                                Margin="0,0,20,0"/>

                        <!-- Avatar Preview - Rounded Square (Reliable) -->
                        <Border x:Name="brdAvatarPreview"
                                Width="300"
                                Height="300"
                                BorderBrush="White"
                                BorderThickness="3"
                                Background="#1E1E1E"
                                CornerRadius="16"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Image x:Name="imgAvatar"
                                   Width="290"
                                   Height="290"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                    </StackPanel>

                    <!-- Status -->
                    <TextBlock x:Name="lblAvatarStatus"
                               Text=""
                               Foreground="#888888"
                               FontSize="12"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- TAB 2: RACE -->
            <TabItem Header="2. Race">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SELECT RACE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbRace"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  SelectionChanged="cmbRace_SelectionChanged"/>
                        <TextBlock Text="SUBRACE (if applicable)"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,16,0,6"
                                   Foreground="#CCC"/>

                        <ComboBox x:Name="cmbSubrace"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  SelectionChanged="cmbSubrace_SelectionChanged"
                                  IsEnabled="False"/>

                        <StackPanel x:Name="pnlFlexibleBonuses"
                                    Visibility="Collapsed"
                                    Margin="0,12,0,0">
                            <TextBlock Text="CHOOSE FLEXIBLE RACIAL BONUSES"
                                       FontWeight="Bold"
                                       Foreground="#CCC"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="cmbFlexibleBonus1"
                                          Height="32"
                                          Margin="0,0,6,0"
                                          Background="#2A2A2A"
                                          Foreground="#2A2A2A"/>
                                <ComboBox x:Name="cmbFlexibleBonus2"
                                          Height="32"
                                          Grid.Column="1"
                                          Background="#2A2A2A"
                                          Foreground="#2A2A2A"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="pnlRaceSkillChoice"
                                    Visibility="Collapsed"
                                    Margin="0,15,0,0">
                            <TextBlock x:Name="lblRaceSkillHeader"
                                       Text="CUSTOM LINEAGE CHOICES"
                                       Foreground="#7CFC00"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>

                            <RadioButton x:Name="rbRaceDarkvision"
                                         Content="Darkvision (60 ft)"
                                         GroupName="CustomLineage"
                                         Checked="RaceSkillChoice_Changed"
                                         Foreground="White"/>

                            <RadioButton x:Name="rbRaceSkill"
                                         Content="Proficiency in one skill of your choice"
                                         GroupName="CustomLineage"
                                         Checked="RaceSkillChoice_Changed"
                                         Foreground="White"
                                         Margin="0,6,0,0"/>

                            <ComboBox x:Name="cmbRaceSkillChoice"
                                      Width="320"
                                      Margin="25,8,0,0"
                                      Visibility="Collapsed"
                                      SelectionChanged="RaceGrantedSkill_Changed"
                                      Background="#2A2A2A"
                                      Foreground="#2A2A2A"
                                      BorderBrush="#555"/>
                        </StackPanel>

                        <!-- HIGH ELF CANTRIP CHOICE -->
                        <StackPanel x:Name="pnlHighElfCantrip"
                                    Visibility="Collapsed"
                                    Margin="0,18,0,0">
                            <TextBlock Text="HIGH ELF CANTRIP"
                                       FontWeight="Bold"
                                       Foreground="#CCC"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbHighElfCantrip"
                                      Height="34"
                                      Background="#2A2A2A"
                                      Foreground="#2A2A2A"
                                      BorderBrush="#555"
                                      SelectionChanged="HighElfCantrip_SelectionChanged"/>
                        </StackPanel>

                        <!-- HIGH ELF CANTRIP PREVIEW (below race details) -->
                        <Border x:Name="pnlHighElfCantripPreview"
                                Grid.Column="1"
                                Margin="25,20,0,0"
                                Background="#1E1E1E"
                                BorderBrush="#7CFC00"
                                BorderThickness="1"
                                Padding="15"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="CANTRIP DETAILS"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#7CFC00"
                                           Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtHighElfCantripPreview"
                                           Foreground="White"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Racial Ability Bonuses will be automatically applied to your stats."
                                   Foreground="#AAA"
                                   FontSize="12"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1"
                                  Margin="25,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtRaceDetails"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="19"
                                   Foreground="#DDD"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: BACKGROUND -->
            <TabItem Header="3. Background">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel>
                        <TextBlock Text="SELECT BACKGROUND"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbBackground"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  SelectionChanged="cmbBackground_SelectionChanged"/>

                        <!-- Language panel stays on left for consistency with Race skill choice -->
                        <StackPanel x:Name="pnlBackgroundLanguages"
                                    Margin="0,20,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="SELECT LANGUAGES"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbBackgroundLanguage1"
                                      Width="320"
                                      Height="32"
                                      FontSize="14"
                                      Background="#2A2A2A"
                                      Foreground="#2A2A2A"
                                      BorderBrush="#555"
                                      Margin="0,0,0,8"
                                      Visibility="Collapsed"/>
                            <ComboBox x:Name="cmbBackgroundLanguage2"
                                      Width="320"
                                      Height="32"
                                      FontSize="14"
                                      Background="#2A2A2A"
                                      Foreground="#2A2A2A"
                                      BorderBrush="#555"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Details -->
                    <ScrollViewer Grid.Column="1"
                                  Margin="25,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtBackgroundDetails"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="19"
                                   Foreground="#DDD"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 4: CLASS &amp; SUBCLASS -->
            <TabItem Header="4. Class &amp; Subclass">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SELECT CLASS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="cmbClass"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  SelectionChanged="cmbClass_SelectionChanged"/>

                        <TextBlock Text="SUBCLASS"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,16,0,6"/>
                        <ComboBox x:Name="cmbSubclass"
                                  Height="34"
                                  FontSize="15"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  BorderBrush="#555"
                                  Padding="8,4"
                                  IsEnabled="False"/>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1"
                                  Margin="25,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtClassDetails"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="19"
                                   Foreground="#DDD"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 5: ABILITY SCORES -->
            <TabItem Header="5. Ability Scores">
                <StackPanel Margin="25">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <TextBlock Text="STAT GENERATION METHOD:"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <RadioButton x:Name="rbPointBuy"
                                     Content="Point Buy (27 pts)"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="18,0,0,0"
                                     IsChecked="True"/>
                        <RadioButton x:Name="rbStandardArray"
                                     Content="Standard Array (15,14,13,12,10,8)"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="14,0,0,0"/>
                        <RadioButton x:Name="rbRoll4d6"
                                     Content="Roll 4d6 drop lowest"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="14,0,0,0"/>
                        <RadioButton x:Name="rbRoll3d6"
                                     Content="Roll 3d6 straight"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="14,0,0,0"/>
                        <RadioButton x:Name="rbCustom"
                                     Content="Custom (1-20)"
                                     GroupName="StatMethod"
                                     Checked="StatMethod_Changed"
                                     Margin="14,0,0,0"/>
                    </StackPanel>

                    <Button x:Name="btnRollStats"
                            Content="🎲 ROLL STATS"
                            Width="170"
                            Height="36"
                            Click="btnRollStats_Click"
                            Background="#5C8A6E"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Margin="0,0,0,18"
                            Visibility="Collapsed"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <!-- Ability -->
                            <ColumnDefinition Width="85"/>
                            <!-- Base -->
                            <ColumnDefinition Width="70"/>
                            <!-- Racial -->
                            <ColumnDefinition Width="70"/>
                            <!-- Final -->
                            <ColumnDefinition Width="90"/>
                            <!-- Modifier -->
                            <ColumnDefinition Width="160"/>
                            <!-- Roll Breakdown (NEW) -->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Ability"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>
                        <TextBlock Text="Base"
                                   Grid.Column="1"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>
                        <TextBlock Text="Racial"
                                   Grid.Column="2"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>
                        <TextBlock Text="Final"
                                   Grid.Column="3"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>
                        <TextBlock Text="Modifier"
                                   Grid.Column="4"
                                   FontWeight="Bold"
                                   Foreground="#CCC"/>

                        <!-- Strength -->
                        <TextBlock Text="Strength"
                                   Grid.Row="1"/>
                        <TextBox x:Name="txtStrBase"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Width="60"
                                 Text="8"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 TextChanged="Stat_TextChanged"
                                 LostFocus="Stat_LostFocus"/>
                        <TextBlock x:Name="lblStrRoll"
                                   Grid.Row="1"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtStrRacial"
                                   Grid.Row="1"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtStrFinal"
                                   Grid.Row="1"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="txtStrMod"
                                   Grid.Row="1"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"/>

                        <!-- Dexterity -->
                        <TextBlock Text="Dexterity"
                                   Grid.Row="2"/>
                        <TextBox x:Name="txtDexBase"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Width="60"
                                 Text="8"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 TextChanged="Stat_TextChanged"
                                 LostFocus="Stat_LostFocus"/>
                        <TextBlock x:Name="lblDexRoll"
                                   Grid.Row="2"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtDexRacial"
                                   Grid.Row="2"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtDexFinal"
                                   Grid.Row="2"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="txtDexMod"
                                   Grid.Row="2"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"/>

                        <!-- Constitution -->
                        <TextBlock Text="Constitution"
                                   Grid.Row="3"/>
                        <TextBox x:Name="txtConBase"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Width="60"
                                 Text="8"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 TextChanged="Stat_TextChanged"
                                 LostFocus="Stat_LostFocus"/>
                        <TextBlock x:Name="lblConRoll"
                                   Grid.Row="3"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtConRacial"
                                   Grid.Row="3"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtConFinal"
                                   Grid.Row="3"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="txtConMod"
                                   Grid.Row="3"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"/>

                        <!-- Intelligence -->
                        <TextBlock Text="Intelligence"
                                   Grid.Row="4"/>
                        <TextBox x:Name="txtIntBase"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Width="60"
                                 Text="8"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 TextChanged="Stat_TextChanged"
                                 LostFocus="Stat_LostFocus"/>
                        <TextBlock x:Name="lblIntRoll"
                                   Grid.Row="4"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtIntRacial"
                                   Grid.Row="4"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtIntFinal"
                                   Grid.Row="4"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="txtIntMod"
                                   Grid.Row="4"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"/>

                        <!-- Wisdom -->
                        <TextBlock Text="Wisdom"
                                   Grid.Row="5"/>
                        <TextBox x:Name="txtWisBase"
                                 Grid.Row="5"
                                 Grid.Column="1"
                                 Width="60"
                                 Text="8"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 TextChanged="Stat_TextChanged"
                                 LostFocus="Stat_LostFocus"/>
                        <TextBlock x:Name="lblWisRoll"
                                   Grid.Row="5"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtWisRacial"
                                   Grid.Row="5"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtWisFinal"
                                   Grid.Row="5"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="txtWisMod"
                                   Grid.Row="5"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"/>

                        <!-- Charisma -->
                        <TextBlock Text="Charisma"
                                   Grid.Row="6"/>
                        <TextBox x:Name="txtChaBase"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Width="60"
                                 Text="8"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#555"
                                 TextChanged="Stat_TextChanged"
                                 LostFocus="Stat_LostFocus"/>
                        <TextBlock x:Name="lblChaRoll"
                                   Grid.Row="6"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtChaRacial"
                                   Grid.Row="6"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtChaFinal"
                                   Grid.Row="6"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="txtChaMod"
                                   Grid.Row="6"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"/>
                    </Grid>

                    <StackPanel Orientation="Vertical"
                                Margin="0,18,0,0">
                        <TextBlock x:Name="lblPointBuy"
                                   Text="Points Remaining: 27"
                                   FontSize="15"
                                   Foreground="#7CFC00"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="btnResetPointBuy"
                                Content="🔄 Reset Ability Scores"
                                Width="170"
                                Height="36"
                                Click="btnResetPointBuy_Click"
                                Background="#E74C3C"
                                Foreground="White"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Left"
                                Margin="0,30,0,0"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- TAB 6: SKILLS &amp; PROFICIENCIES -->
            <TabItem Header="6. Skills &amp; Proficiencies"
                     x:Name="tabSkills">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <!-- Left: labels + saves + initiative -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: skills table -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,20,0">

                        <!-- CLASS SKILL CHOICES -->
                        <TextBlock Text="CLASS SKILL CHOICES"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,2"/>

                        <TextBlock x:Name="lblClassSkillChoicesDetail"
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="lblClassSkillCounter"
                                   Foreground="White"
                                   FontSize="13"
                                   Margin="0,0,0,16"/>

                        <!-- RACE PROFICIENCIES -->
                        <TextBlock Text="RACE PROFICIENCIES"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,2"/>

                        <TextBlock x:Name="lblRaceProficienciesDetail"
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <!-- BACKGROUND PROFICIENCIES -->
                        <TextBlock Text="BACKGROUND PROFICIENCIES"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,2"/>

                        <TextBlock x:Name="lblBackgroundProficienciesDetail"
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <!-- SAVING THROWS -->
                        <TextBlock Text="SAVING THROWS"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,16,0,8"/>

                        <StackPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Strength Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtStrSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Dexterity Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtDexSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Constitution Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtConSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Intelligence Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtIntSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Wisdom Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtWisSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Charisma Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtChaSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- INITIATIVE -->
                        <TextBlock Text="INITIATIVE"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="txtInitiative"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <!-- NEW: BASE ARMOR CLASS -->
                        <TextBlock Text="BASE ARMOR CLASS (AC)"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,16,0,4"/>

                        <TextBlock x:Name="txtBaseAC"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <!-- NEW: HIT POINTS -->
                        <TextBlock Text="HIT POINTS (HP)"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,16,0,4"/>

                        <TextBlock x:Name="txtHitPoints"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <!-- RIGHT COLUMN - Skills Table -->
                    <DataGrid x:Name="dgSkills"
                              Grid.Column="1"
                              AutoGenerateColumns="False"
                              Background="#252525"
                              RowBackground="#252525"
                              AlternatingRowBackground="#2A2A2A"
                              Foreground="White"
                              BorderBrush="#555555"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#2A2A2A"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                                <Setter Property="Padding"
                                        Value="8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Skill"
                                                Binding="{Binding SkillName}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Ability"
                                                Binding="{Binding Ability}"
                                                Width="60"/>
                            <DataGridTextColumn Header="Bonus"
                                                Binding="{Binding Bonus}"
                                                Width="70"/>
                            <!-- Proficient Checkbox with proper IsSelectable control -->
                            <DataGridTemplateColumn Header="Proficient?"
                                                    Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsProficient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsSelectable}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>

            <!-- TAB 7: STARTING EQUIPMENT -->
            <TabItem Header="7. Starting Equipment">
                <Grid Margin="25">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Labels + Choices -->
                        <ColumnDefinition Width="380"/>
                        <!-- Middle: Weapon ComboBoxes -->
                        <ColumnDefinition Width="380"/>
                        <!-- Right: Reference Tables -->
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel Grid.Column="0">

                        <!-- YOUR PROFICIENCIES -->
                        <TextBlock Text="YOUR PROFICIENCIES"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   Margin="0,0,0,8"/>
                        <StackPanel x:Name="pnlProficiencySummary"
                                    Margin="10,0,0,20"
                                    Orientation="Vertical"/>

                        <!-- Equipment Choices (this is where radios + combos go) -->
                        <StackPanel x:Name="pnlEquipmentChoices"/>

                        <!-- BACKGROUND EQUIPMENT -->
                        <TextBlock Text="BACKGROUND EQUIPMENT"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="15"
                                   Margin="0,25,0,8"/>
                        <TextBlock x:Name="txtBackgroundEquipment"
                                   Foreground="White"
                                   Margin="10,0,0,20"
                                   TextWrapping="Wrap"
                                   FontSize="13"/>

                        <!-- CARRYING CAPACITY (moved above total equipment) -->
                        <TextBlock Text="CARRYING CAPACITY"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,13,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ProgressBar x:Name="pbCarryingCapacity"
                                         Height="24"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Background="#333"
                                         Foreground="#4A7C59"
                                         BorderBrush="#555"/>

                            <TextBlock x:Name="lblCarryingCapacity"
                                       Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <TextBlock x:Name="lblPushDragLift"
                                   Text="Push / Drag / Lift: — lbs"
                                   Foreground="#AAA"
                                   FontSize="12"
                                   Margin="0,6,0,0"/>


                    </StackPanel>

                    <!-- MIDDLE COLUMN: Weapon Selection ComboBoxes -->
                    <StackPanel x:Name="pnlWeaponChoices"
                                Grid.Column="1"
                                Margin="15,0,15,0"
                                Width="270">

                        <TextBlock Text="SELECT WEAPONS"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="cmbWeaponChoice1"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice2"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice3"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice4"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice5"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice6"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#2A2A2A"
                                  Visibility="Collapsed"/>

                        <!-- YOUR TOTAL STARTING EQUIPMENT -->
                        <TextBlock Text="YOUR TOTAL STARTING EQUIPMENT"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="15"
                                   Margin="0,4,0,8"/>
                        <ScrollViewer Height="280"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="pnlTotalEquipmentSummary"/>
                        </ScrollViewer>

                        <!-- EQUIPPED ARMOR CLASS (AC) - appears only if armor equipped -->
                        <TextBlock x:Name="lblEquippedACHeader"
                                   Text="EQUIPPED ARMOR CLASS (AC)"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,13,0,6"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="txtEquippedAC"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Dynamic Weapon Table + Armor Table -->
                    <StackPanel Grid.Column="2"
                                Margin="30,0,0,0"
                                Width="520">

                        <!-- Dynamic Weapon Reference Table -->
                        <StackPanel>
                            <TextBlock Text="WEAPON TYPE"
                                       FontWeight="Bold"
                                       Foreground="#7CFC00"
                                       FontSize="14"
                                       Margin="0,0,0,6"/>

                            <ComboBox x:Name="cmbWeaponType"
                                      Height="32"
                                      Background="#2A2A2A"
                                      Foreground="#2A2A2A"
                                      BorderBrush="#555"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Simple Weapons"/>
                                <ComboBoxItem Content="Martial Weapons"/>
                            </ComboBox>

                            <DataGrid x:Name="dgWeaponRef"
                                      Height="350"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#252525"
                                      RowBackground="#252525"
                                      AlternatingRowBackground="#2A2A2A"
                                      Foreground="White"
                                      GridLinesVisibility="None"
                                      Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Weapon"
                                                        Binding="{Binding Name}"
                                                        Width="140"/>
                                    <DataGridTextColumn Header="Damage"
                                                        Binding="{Binding Damage}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding Type}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Range"
                                                        Binding="{Binding Range}"
                                                        Width="60"/>
                                    <DataGridTextColumn Header="Properties"
                                                        Binding="{Binding Properties}"
                                                        Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping"
                                                        Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- Armor Table -->
                        <TextBlock Text="ARMOR"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,20,0,8"/>

                        <DataGrid x:Name="dgArmorRef"
                                  Height="280"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#252525"
                                  RowBackground="#252525"
                                  AlternatingRowBackground="#2A2A2A"
                                  Foreground="White"
                                  GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Armor"
                                                    Binding="{Binding Name}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding Type}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="AC"
                                                    Binding="{Binding AC}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Str Req"
                                                    Binding="{Binding StrengthRequirement}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Stealth"
                                                    Binding="{Binding StealthDisplay}"
                                                    Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>
            <!-- TAB 8: FEATS (Only visible for Variant Human / Custom Lineage) -->
            <TabItem x:Name="tabFeats"
                     Header="8. Feats"
                     Visibility="Collapsed">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Feat Table -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SELECT ONE FEAT"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="dgFeats"
                                  AutoGenerateColumns="False"
                                  Height="520"
                                  Background="#252525"
                                  RowBackground="#252525"
                                  AlternatingRowBackground="#2A2A2A"
                                  Foreground="White"
                                  BorderBrush="Gray"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="None">

                            <DataGrid.Columns>
                                <!-- Checkbox -->
                                <DataGridTemplateColumn Header=""
                                                        Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="FeatCheckBox_Changed"
                                                      Unchecked="FeatCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Feat Name"
                                                    Binding="{Binding Name}"
                                                    Width="220"
                                                    FontWeight="SemiBold"/>

                                <!-- FIXED: Description column with proper TextWrapping -->
                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding ShortDescription}"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping"
                                                    Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Right: Details Panel -->
                    <Border Grid.Column="1"
                            Width="420"
                            Margin="20,0,0,0"
                            Background="#1E1E1E"
                            BorderBrush="#7CFC00"
                            BorderThickness="1"
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="FEAT DETAILS"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#7CFC00"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="txtFeatDetails"
                                       Text="Select a feat from the list to see full details."
                                       Foreground="White"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>
                            <!-- Dynamic Stat Choice ComboBoxes (for feats like Shadow Touched, Athlete, etc.) -->
                            <StackPanel x:Name="pnlFeatStatChoices"
                                        Visibility="Collapsed"
                                        Margin="0,18,0,0">

                                <TextBlock x:Name="lblFeatStatChoiceHeader"
                                           Text="CHOOSE ABILITY SCORE(S) TO INCREASE"
                                           FontWeight="Bold"
                                           Foreground="#7CFC00"
                                           Margin="0,0,0,6"/>

                                <ComboBox x:Name="cmbFeatStatChoice1"
                                          Height="32"
                                          Background="#2A2A2A"
                                          Foreground="#2A2A2A"
                                          Margin="0,0,0,8"
                                          SelectionChanged="FeatStatChoice_Changed"/>

                                <ComboBox x:Name="cmbFeatStatChoice2"
                                          Height="32"
                                          Background="#2A2A2A"
                                          Foreground="#2A2A2A"
                                          Visibility="Collapsed"
                                          SelectionChanged="FeatStatChoice_Changed"/>

                                <ComboBox x:Name="cmbFeatStatChoice3"
                                          Height="32"
                                          Background="#2A2A2A"
                                          Foreground="#2A2A2A"
                                          Visibility="Collapsed"
                                          SelectionChanged="FeatStatChoice_Changed"/>

                                <ComboBox x:Name="cmbFeatStatChoice4"
                                          Height="32"
                                          Background="#2A2A2A"
                                          Foreground="#2A2A2A"
                                          Visibility="Collapsed"
                                          SelectionChanged="FeatStatChoice_Changed"/>

                            </StackPanel>
                            <!-- === FEAT SPELL PREVIEW (below combo boxes) === -->
                            <Border x:Name="brdFeatSpellPreview"
                                    Background="#1E1E1E"
                                    BorderBrush="#444"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,12,0,0"
                                    Padding="10"
                                    Visibility="Collapsed">

                                <StackPanel>
                                    <TextBlock Text="SELECTED SPELL DETAILS"
                                               FontWeight="Bold"
                                               Foreground="#7CFC00"
                                               FontSize="13"
                                               Margin="0,0,0,6"/>

                                    <TextBlock x:Name="txtFeatSpellDetails"
                                               Foreground="White"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 9: SPELLS & CANTRIPS -->
            <TabItem x:Name="tabSpells"
                     Header="9. Spells &amp; Cantrips"
                     Visibility="Collapsed">

                <StackPanel Margin="25">

                    <TextBlock x:Name="lblSpellStats"
                               Text="Spellcasting Ability: Wisdom | Spell Save DC: 13 | Spell Attack: +5"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#7CFC00"
                               Margin="0,18,0,0"/>

                    <TextBlock x:Name="lblRacialSpells"
                               Text="Racial spells: (none yet)"
                               Foreground="#AAA"
                               FontSize="12"
                               Margin="0,0,0,2"/>

                    <TextBlock x:Name="lblFeatSpells"
                               Text="Feat spells: (none yet)"
                               Foreground="#AAA"
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="lblSubclassSpells"
                               Text="Subclass spells: (none yet)"
                               Foreground="#AAA"
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <!-- Two tables side by side -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CANTRIPS (Left) -->
                        <StackPanel>
                            <TextBlock x:Name="lblCantripHeader"
                                       Text="CANTRIPS (select up to your class limit)"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#7CFC00"
                                       Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgCantrips"
                                      AutoGenerateColumns="False"
                                      Height="340"
                                      Background="#252525"
                                      RowBackground="#252525"
                                      AlternatingRowBackground="#2A2A2A"
                                      Foreground="White"
                                      BorderBrush="#555"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      IsSynchronizedWithCurrentItem="False"
                                      SelectionChanged="dgCantrips_SelectionChanged">
                                <DataGrid.Columns>
                                    <!-- Custom Checkbox Column -->
                                    <DataGridTemplateColumn Header=""
                                                            Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding IsSelectable}"
                                                          Checked="CantripCheckBox_Changed"
                                                          Unchecked="CantripCheckBox_Changed"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Cantrip"
                                                        Binding="{Binding Name}"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="Dice"
                                                        Binding="{Binding DamageDice}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Roll"
                                                        Binding="{Binding RollType}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding DamageType}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Range"
                                                        Binding="{Binding FullSpell.Range}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Casting Time"
                                                        Binding="{Binding FullSpell.CastingTime}"
                                                        Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="lblCantripCount"
                                       Text="Selected: 0 / 3"
                                       Foreground="White"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- 1ST LEVEL SPELLS (Right) -->
                        <StackPanel Grid.Column="1"
                                    Margin="25,0,0,0">
                            <TextBlock x:Name="lblSpellHeader"
                                       Text="1ST LEVEL SPELLS (prepare = Wis/Cha/Int mod + 1)"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#7CFC00"
                                       Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgSpells1"
                                      AutoGenerateColumns="False"
                                      Height="340"
                                      Background="#252525"
                                      RowBackground="#252525"
                                      AlternatingRowBackground="#2A2A2A"
                                      Foreground="White"
                                      BorderBrush="#555"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      IsSynchronizedWithCurrentItem="False"
                                      SelectionChanged="dgSpells1_SelectionChanged">

                                <DataGrid.Columns>
                                    <!-- Checkbox Column -->
                                    <DataGridTemplateColumn Header=""
                                                            Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding IsSelectable}"
                                                          Checked="Spell1CheckBox_Changed"
                                                          Unchecked="Spell1CheckBox_Changed"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Spell"
                                                        Binding="{Binding Name}"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="Dice"
                                                        Binding="{Binding DamageDice}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Roll"
                                                        Binding="{Binding RollType}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding DamageType}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Range"
                                                        Binding="{Binding FullSpell.Range}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Casting Time"
                                                        Binding="{Binding FullSpell.CastingTime}"
                                                        Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="lblSpellCount"
                                       Text="Selected: 0 / 4"
                                       Foreground="White"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- CANTRIP PREVIEW PANEL - NOW BELOW BOTH TABLES -->
                    <Border x:Name="pnlCantripPreview"
                            Margin="0,25,0,0"
                            Background="#1E1E1E"
                            BorderBrush="#7CFC00"
                            BorderThickness="1"
                            Padding="15"
                            Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock Text="Spell Details"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#7CFC00"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="txtCantripPreview"
                                       Foreground="White"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </TabItem>

            <!-- TAB 10: SUMMARY &amp; EXPORT -->
            <TabItem Header="10. Summary &amp; Export">
                <StackPanel Margin="30"
                            MaxWidth="900">
                    <TextBlock Text="CHARACTER SUMMARY"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock x:Name="txtSummary"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Background="#252525"
                               Padding="15"
                               Height="420"
                               VerticalAlignment="Top"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,25,0,0">
                        <Button Content="💾 Save Character (JSON)"
                                Click="SaveCharacter_Click"
                                Width="210"
                                Height="42"
                                Background="#4A7C59"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="8"/>
                        <Button Content="📂 Load Character"
                                Click="LoadCharacter_Click"
                                Width="190"
                                Height="42"
                                Background="#5C8A6E"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="8"/>
                        <Button Content="📄 Export to PDF"
                                Click="ExportPDF_Click"
                                Width="190"
                                Height="42"
                                Background="#2E8B57"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="8"/>
                        <Button Content="Export Fillable PDF"
                                Click="ExportFillablePDF_Click"
                                Width="190"
                                Height="42"
                                Margin="8"
                                Background="#4CAF50"
                                Foreground="White"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>