                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Intelligence -->
                        <TextBlock Text="Intelligence"
                                   Grid.Row="4"
                                   VerticalAlignment="Center"/>
                        <StackPanel x:Name="pnlIntBaseStepper"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="btnIntBaseDec"
                                    Content="−"
                                    Width="26"
                                    Height="26"
                                    Tag="Int"
                                    Click="PointBuyStat_Dec"
                                    ToolTip="Decrease base score"
                                    Style="{StaticResource Nemo.Button.Subtle}"
                                    FontSize="14"/>
                            <TextBox x:Name="txtIntBase"
                                     Width="42"
                                     Height="26"
                                     Margin="3,0"
                                     Text="8"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="#2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#555"
                                     TextChanged="Stat_TextChanged"
                                     LostFocus="Stat_LostFocus"/>
                            <Button x:Name="btnIntBaseInc"
                                    Content="+"
                                    Width="26"
                                    Height="26"
                                    Tag="Int"
                                    Click="PointBuyStat_Inc"
                                    ToolTip="Increase base score"
                                    Style="{StaticResource Nemo.Button.Subtle}"
                                    FontSize="14"/>
                        </StackPanel>
                        <TextBlock x:Name="lblIntRoll"
                                   Grid.Row="4"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtIntRacial"
                                   Grid.Row="4"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtIntFinal"
                                   Grid.Row="4"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtIntMod"
                                   Grid.Row="4"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Wisdom -->
                        <TextBlock Text="Wisdom"
                                   Grid.Row="5"
                                   VerticalAlignment="Center"/>
                        <StackPanel x:Name="pnlWisBaseStepper"
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="btnWisBaseDec"
                                    Content="−"
                                    Width="26"
                                    Height="26"
                                    Tag="Wis"
                                    Click="PointBuyStat_Dec"
                                    ToolTip="Decrease base score"
                                    Style="{StaticResource Nemo.Button.Subtle}"
                                    FontSize="14"/>
                            <TextBox x:Name="txtWisBase"
                                     Width="42"
                                     Height="26"
                                     Margin="3,0"
                                     Text="8"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="#2A2A2A"
                                     Foreground="White"
                                     BorderBrush="#555"
                                     TextChanged="Stat_TextChanged"
                                     LostFocus="Stat_LostFocus"/>
                            <Button x:Name="btnWisBaseInc"
                                    Content="+"
                                    Width="26"
                                    Height="26"
                                    Tag="Wis"
                                    Click="PointBuyStat_Inc"
                                    ToolTip="Increase base score"
                                    Style="{StaticResource Nemo.Button.Subtle}"
                                    FontSize="14"/>
                        </StackPanel>
                        <TextBlock x:Name="lblWisRoll"
                                   Grid.Row="5"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWisRacial"
                                   Grid.Row="5"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWisFinal"
                                   Grid.Row="5"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWisMod"
                                   Grid.Row="5"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Charisma -->
                        <TextBlock Text="Charisma"
                                   Grid.Row="6"
                                   VerticalAlignment="Center"/>
                        <StackPanel x:Name="pnlChaBaseStepper"
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="btnChaBaseDec"
                                    Content="−"
                                    Width="26"
                                    Height="26"
                                    Tag="Cha"
                                    Click="PointBuyStat_Dec"
                                    ToolTip="Decrease base score"
                                    Style="{StaticResource Nemo.Button.Subtle}"
                                    FontSize="14"/>
                            <TextBox x:Name="txtChaBase"
                                     Width="42"
                                     Height="26"
                                     Margin="3,0"
                                     Text="8"
                                     TextAlignment="Center"
