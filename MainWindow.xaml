                                    FontSize="14"/>
                        </StackPanel>
                        <TextBlock x:Name="lblChaRoll"
                                   Grid.Row="6"
                                   Grid.Column="5"
                                   Margin="4,0,0,0"
                                   Foreground="White"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtChaRacial"
                                   Grid.Row="6"
                                   Grid.Column="2"
                                   Text="+0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtChaFinal"
                                   Grid.Row="6"
                                   Grid.Column="3"
                                   Text="8"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtChaMod"
                                   Grid.Row="6"
                                   Grid.Column="4"
                                   Text="+0"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Vertical"
                                Margin="0,18,0,0">
                        <TextBlock x:Name="lblPointBuy"
                                   Text="Points Remaining: 27"
                                   FontSize="15"
                                   Foreground="#7CFC00"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="btnResetPointBuy"
                                Content="🔄 Reset Ability Scores"
                                Width="170"
                                Height="36"
                                Click="btnResetPointBuy_Click"
                                Style="{StaticResource Nemo.Button.Danger}"
                                HorizontalAlignment="Left"
                                Margin="0,30,0,0"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- TAB 6: LEVEL &amp; MULTICLASS -->
            <TabItem x:Name="tabLevelMulticlass"
                     Header="6. Level &amp; Multiclass">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="20">
                    <StackPanel>
                        <TextBlock Text="LEVEL &amp; MULTICLASS"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Assign levels to one or more classes. When a class hits an ASI level (usually 4, 8, 12…), choose an Ability Score Improvement or a Feat. Feat picks increase how many feats you can select on the Feats tab."
                                   TextWrapping="Wrap"
                                   Foreground="#AAA"
                                   FontSize="12"
                                   Margin="0,0,0,12"/>

                        <!-- Summary strip -->
                        <Border Background="#252525"
                                BorderBrush="#444"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,0,14"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock x:Name="lblLevelSummary"
                                           Text="Total level: 1  |  Proficiency: +2  |  Hit dice: —  |  HP: —"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#9CDCFE"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="lblMulticlassPrereqStatus"
                                           Text=""
                                           FontSize="12"
                                           Foreground="#E8C36A"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="CLASS LEVELS"
                                       FontWeight="Bold"
                                       Foreground="#7CFC00"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="btnAddClassLevel"
                                    DockPanel.Dock="Right"
                                    Content="+ Add class (multiclass)"
                                    Padding="12,4"
                                    Margin="12,0,0,0"
                                    Click="btnAddClassLevel_Click"
                                    Style="{StaticResource Nemo.Button.Primary}"/>
                        </DockPanel>

                        <StackPanel x:Name="pnlClassLevelRows"
                                    Margin="0,0,0,16"/>

                        <TextBlock Text="HIT POINT GAIN (levels after 1st)"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,4,0,6"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <RadioButton x:Name="rbHpAverage"
                                         Content="Fixed average (PHB)"
                                         GroupName="HpGain"
                                         IsChecked="True"
                                         Checked="HpGainMethod_Changed"
                                         Margin="0,0,18,0"/>
                            <RadioButton x:Name="rbHpRolled"
                                         Content="Rolled hit die"
                                         GroupName="HpGain"
                                         Checked="HpGainMethod_Changed"/>
                        </StackPanel>

                        <!-- Shown when Rolled is selected: one row per level after 1st -->
                        <Border x:Name="pnlHpRollsSection"
                                Visibility="Collapsed"
                                Background="#252525"
                                BorderBrush="#444"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,0,16"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="HIT DIE ROLLS (levels 2+)"
                                           FontWeight="SemiBold"
                                           Foreground="#9CDCFE"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Enter the hit die result (1 through die size), or click Roll for a random die. HP gained that level = die + Constitution modifier (minimum 1). Level 1 always uses maximum hit die."
                                           TextWrapping="Wrap"
                                           Foreground="#AAA"
                                           FontSize="11"
                                           Margin="0,0,0,10"/>
                                <StackPanel x:Name="pnlHpRollRows"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ASI / FEAT CHOICES"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,4,0,4"/>
                        <TextBlock x:Name="lblAsiFeatHint"
                                   Text="No ASI/feat milestones yet. Reach class level 4 (or Fighter 6, Rogue 10, …) to unlock choices."
                                   Foreground="#AAA"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <StackPanel x:Name="pnlAsiFeatChoices"/>

                        <TextBlock x:Name="lblAsiBonusSummary"
                                   Text="ASI bonuses applied: (none)"
                                   Foreground="#9CDCFE"
                                   FontSize="12"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="CLASS FEATURE PICKS"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,20,0,4"/>
                        <TextBlock x:Name="lblClassOptionHint"
                                   Text="Fighting Styles (Fighter), Eldritch Invocations (Warlock), and Metamagic (Sorcerer) appear here as you gain the right class levels."
                                   Foreground="#AAA"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <StackPanel x:Name="pnlClassFeatureOptions"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 7: SKILLS &amp; PROFICIENCIES -->
            <TabItem Header="7. Skills &amp; Proficiencies"
                     x:Name="tabSkills">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <!-- Left: labels + saves + initiative -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: skills table -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,20,0">

                        <!-- CLASS SKILL CHOICES -->
                        <TextBlock Text="CLASS SKILL CHOICES"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,2"/>

                        <TextBlock x:Name="lblClassSkillChoicesDetail"
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="lblClassSkillCounter"
                                   Foreground="White"
                                   FontSize="13"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="lblExpertiseCounter"
                                   Foreground="White"
                                   FontSize="13"
                                   Margin="0,0,0,4"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="lblJackOfAllTradesNote"
                                   Foreground="#AAA"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"
                                   Visibility="Collapsed"
                                   Text="Jack of All Trades (Bard 2+): +½ proficiency on non-proficient ability checks (including skills and initiative)."/>

                        <!-- RACE PROFICIENCIES -->
                        <TextBlock Text="RACE PROFICIENCIES"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,2"/>

                        <TextBlock x:Name="lblRaceProficienciesDetail"
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <!-- BACKGROUND PROFICIENCIES -->
                        <TextBlock Text="BACKGROUND PROFICIENCIES"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,2"/>

                        <TextBlock x:Name="lblBackgroundProficienciesDetail"
                                   Foreground="White"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <!-- PROFICIENCY BONUS (scales with total character level) -->
                        <TextBlock x:Name="lblProficiencyBonus"
                                   Text="Proficiency Bonus: +2 (character level 1)"
                                   FontWeight="SemiBold"
                                   Foreground="#9CDCFE"
                                   FontSize="13"
                                   Margin="0,16,0,8"/>

                        <!-- SAVING THROWS -->
                        <TextBlock Text="SAVING THROWS"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                        <StackPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Strength Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtStrSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Dexterity Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtDexSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Constitution Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtConSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Intelligence Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtIntSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Wisdom Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtWisSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,3">
                                <TextBlock Text="Charisma Saving Throw"
                                           Width="220"
                                           Foreground="White"/>
                                <TextBlock x:Name="txtChaSave"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- INITIATIVE -->
                        <TextBlock Text="INITIATIVE"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="txtInitiative"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <!-- NEW: BASE ARMOR CLASS -->
                        <TextBlock Text="BASE ARMOR CLASS (AC)"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,16,0,4"/>

                        <TextBlock x:Name="txtBaseAC"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <!-- NEW: HIT POINTS -->
                        <TextBlock Text="HIT POINTS (HP)"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,16,0,4"/>

                        <TextBlock x:Name="txtHitPoints"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <!-- RIGHT COLUMN - Skills Table -->
                    <DataGrid x:Name="dgSkills"
                              Grid.Column="1"
                              AutoGenerateColumns="False"
                              Background="#252525"
                              RowBackground="#252525"
                              AlternatingRowBackground="#2A2A2A"
                              Foreground="White"
                              BorderBrush="#555555"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              PreviewMouseLeftButtonDown="dgSkills_PreviewMouseLeftButtonDown">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#2A2A2A"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                                <Setter Property="Padding"
                                        Value="8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Skill"
                                                Binding="{Binding SkillName}"
                                                Width="180"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ability"
                                                Binding="{Binding Ability}"
                                                Width="60"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Bonus"
                                                Binding="{Binding Bonus}"
                                                Width="70"
                                                IsReadOnly="True"/>
                            <!-- Proficient: single-click toggle; IsSelectable gates class-choice skills -->
                            <DataGridTemplateColumn x:Name="colSkillProficient"
                                                    Header="Proficient?"
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsProficient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsSelectable, Mode=OneWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  PreviewMouseLeftButtonDown="SkillProficiencyCheckBox_PreviewMouseLeftButtonDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Expertise: only for proficient skills when Rogue/Bard grants Expertise -->
                            <DataGridTemplateColumn x:Name="colSkillExpertise"
                                                    Header="Expertise?"
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsExpertise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsExpertiseSelectable, Mode=OneWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  PreviewMouseLeftButtonDown="SkillExpertiseCheckBox_PreviewMouseLeftButtonDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>

            <!-- TAB 8: STARTING EQUIPMENT -->
            <TabItem Header="8. Starting Equipment">
                <Grid Margin="25">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Labels + Choices -->
                        <ColumnDefinition Width="380"/>
                        <!-- Middle: Weapon ComboBoxes -->
                        <ColumnDefinition Width="380"/>
                        <!-- Right: Reference Tables -->
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN (scrollable so Pack / Carrying Capacity stay reachable) -->
                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">
                    <StackPanel>

                        <!-- YOUR PROFICIENCIES -->
                        <TextBlock Text="YOUR PROFICIENCIES"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   Margin="0,0,0,6"/>
                        <StackPanel x:Name="pnlProficiencySummary"
                                    Margin="10,0,0,12"
                                    Orientation="Vertical"/>

                        <!-- STARTING WEALTH: level-1 gold vs equipment, and higher-level wealth -->
                        <TextBlock Text="STARTING WEALTH"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   Margin="0,0,0,6"/>

                        <Border Background="#1E1E1E"
                                BorderBrush="#444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Level 1: exclusive choice (starting class only) -->
                                <StackPanel x:Name="pnlLevel1WealthMode">
                                    <TextBlock Text="Character level 1 — choose one (starting class only; multiclass later does not re-roll):"
                                               Foreground="#CCC"
                                               FontSize="12"
                                               Margin="0,0,0,6"
                                               TextWrapping="Wrap"/>
                                    <RadioButton x:Name="rbStartingEquipment"
                                                 GroupName="StartingWealthMode"
                                                 IsChecked="True"
                                                 Margin="0,2"
                                                 Checked="StartingWealthMode_Changed">
                                        <TextBlock Text="Take class starting equipment"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"/>
                                    </RadioButton>
                                    <RadioButton x:Name="rbRollStartingGold"
                                                 GroupName="StartingWealthMode"
                                                 Margin="0,2,0,6"
                                                 Checked="StartingWealthMode_Changed">
                                        <TextBlock Text="Roll for gold instead of equipment"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"/>
                                    </RadioButton>

                                    <TextBlock x:Name="txtLevel1GoldFormula"
                                               Text="Formula: —"
                                               Foreground="#E8C36A"
                                               FontSize="12"
                                               Margin="4,0,0,6"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button x:Name="btnRollLevel1Gold"
                                                Content="Roll Gold"
                                                Padding="12,4"
                                                Click="BtnRollLevel1Gold_Click"
                                                IsEnabled="False"/>
                                        <TextBlock x:Name="txtLevel1GoldResult"
                                                   Text=""
                                                   Foreground="#7CFC00"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Text="Background equipment is still granted when you roll for gold."
                                               Foreground="#888"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Levels 5+: gold in addition to equipment (total character level) -->
                                <StackPanel x:Name="pnlHigherLevelWealth"
                                            Visibility="Collapsed"
                                            Margin="0,4,0,0">
                                    <TextBlock Text="Higher-level starting wealth — total character level, once; in addition to starting-class equipment"
                                               Foreground="#CCC"
                                               FontSize="12"
                                               Margin="0,0,0,6"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtHigherLevelWealthFormula"
                                               Text=""
                                               Foreground="#E8C36A"
                                               FontSize="12"
                                               Margin="0,0,0,4"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtHigherLevelMagicNote"
                                               Text=""
                                               Foreground="#888"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnRollHigherLevelGold"
                                                Content="Roll Wealth"
                                                Padding="12,4"
                                                Click="BtnRollHigherLevelGold_Click"/>
                                        <TextBlock x:Name="txtHigherLevelGoldResult"
                                                   Text=""
                                                   Foreground="#7CFC00"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Levels 2–4: no exclusive gold / no wealth band -->
                                <TextBlock x:Name="txtWealthMidLevelNote"
                                           Visibility="Collapsed"
                                           Text="Levels 2–4: use starting-class equipment (and background gear). Wealth bands use total character level from 5+. Multiclassing adds no extra gold."
                                           Foreground="#888"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"/>

                                <!-- Custom gold — always available -->
                                <Border BorderBrush="#555"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,10,0,0"
                                        Padding="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Custom gold (optional)"
                                                   Foreground="#CCC"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBox x:Name="txtCustomGoldGp"
                                                 Width="90"
                                                 Height="28"
                                                 Padding="6,4"
                                                 Background="#2A2A2A"
                                                 Foreground="#F0F0F0"
                                                 BorderBrush="#555"
                                                 CaretBrush="White"
                                                 Text="0"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="TxtCustomGoldGp_TextChanged"/>
                                        <TextBlock Text="gp"
                                                   Foreground="#E8C36A"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Equipment Choices (this is where radios + combos go) -->
                        <StackPanel x:Name="pnlEquipmentChoices"/>

                        <!-- BACKGROUND EQUIPMENT -->
                        <TextBlock Text="BACKGROUND EQUIPMENT"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="15"
                                   Margin="0,16,0,6"/>
                        <TextBlock x:Name="txtBackgroundEquipment"
                                   Foreground="White"
                                   Margin="10,0,0,12"
                                   TextWrapping="Wrap"
                                   FontSize="13"/>

                        <!-- CARRYING CAPACITY -->
                        <TextBlock Text="CARRYING CAPACITY"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,8,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ProgressBar x:Name="pbCarryingCapacity"
                                         Height="24"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Background="#333"
                                         Foreground="#4A7C59"
                                         BorderBrush="#555"/>

                            <TextBlock x:Name="lblCarryingCapacity"
                                       Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <TextBlock x:Name="lblPushDragLift"
                                   Text="Push / Drag / Lift: — lbs"
                                   Foreground="#AAA"
                                   FontSize="12"
                                   Margin="0,6,0,8"/>


                    </StackPanel>
                    </ScrollViewer>

                    <!-- MIDDLE COLUMN: Weapon Selection ComboBoxes -->
                    <StackPanel x:Name="pnlWeaponChoices"
                                Grid.Column="1"
                                Margin="15,0,15,0"
                                Width="270">

                        <TextBlock Text="SELECT WEAPONS"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="cmbWeaponChoice1"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice2"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice3"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice4"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice5"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  Visibility="Collapsed"/>
                        <ComboBox x:Name="cmbWeaponChoice6"
                                  Height="32"
                                  Margin="0,4"
                                  Background="#2A2A2A"
                                  Foreground="#F0F0F0"
                                  Visibility="Collapsed"/>

                        <!-- YOUR TOTAL STARTING EQUIPMENT -->
                        <TextBlock Text="YOUR TOTAL STARTING EQUIPMENT"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="15"
                                   Margin="0,4,0,8"/>
                        <ScrollViewer Height="280"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="pnlTotalEquipmentSummary"/>
                        </ScrollViewer>

                        <!-- EQUIPPED ARMOR CLASS (AC) - appears only if armor equipped -->
                        <TextBlock x:Name="lblEquippedACHeader"
                                   Text="EQUIPPED ARMOR CLASS (AC)"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,13,0,6"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="txtEquippedAC"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- RIGHT COLUMN: Dynamic Weapon Table + Armor Table -->
                    <StackPanel Grid.Column="2"
                                Margin="30,0,0,0"
                                Width="520">

                        <!-- Dynamic Weapon Reference Table -->
                        <StackPanel>
                            <TextBlock Text="WEAPON TYPE"
                                       FontWeight="Bold"
                                       Foreground="#7CFC00"
                                       FontSize="14"
                                       Margin="0,0,0,6"/>

                            <ComboBox x:Name="cmbWeaponType"
                                      Height="32"
                                      Background="#2A2A2A"
                                      Foreground="#F0F0F0"
                                      BorderBrush="#555"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Simple Weapons"/>
                                <ComboBoxItem Content="Martial Weapons"/>
                            </ComboBox>

                            <DataGrid x:Name="dgWeaponRef"
                                      Height="350"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#252525"
                                      RowBackground="#252525"
                                      AlternatingRowBackground="#2A2A2A"
                                      Foreground="White"
                                      GridLinesVisibility="None"
                                      Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Weapon"
                                                        Binding="{Binding Name}"
                                                        Width="140"/>
                                    <DataGridTextColumn Header="Damage"
                                                        Binding="{Binding Damage}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding Type}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Range"
                                                        Binding="{Binding Range}"
                                                        Width="60"/>
                                    <DataGridTextColumn Header="Properties"
                                                        Binding="{Binding Properties}"
                                                        Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping"
                                                        Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- Armor Table -->
                        <TextBlock Text="ARMOR"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   FontSize="14"
                                   Margin="0,20,0,8"/>

                        <DataGrid x:Name="dgArmorRef"
                                  Height="280"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#252525"
                                  RowBackground="#252525"
                                  AlternatingRowBackground="#2A2A2A"
                                  Foreground="White"
                                  GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Armor"
                                                    Binding="{Binding Name}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding Type}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="AC"
                                                    Binding="{Binding AC}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Str Req"
                                                    Binding="{Binding StrengthRequirement}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Stealth"
                                                    Binding="{Binding StealthDisplay}"
                                                    Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>
            <!-- TAB 9: FEATS (origin races and/or ASI feat picks) -->
            <TabItem x:Name="tabFeats"
                     Header="9. Feats"
                     Visibility="Collapsed">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Feat Table -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblFeatTabHeader"
                                   Text="SELECT FEATS"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#7CFC00"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="lblFeatSelectionLimit"
                                   Text="You can select 0 feats."
                                   FontSize="12"
                                   Foreground="#9CDCFE"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="dgFeats"
                                  AutoGenerateColumns="False"
                                  Height="520"
                                  Background="#252525"
                                  RowBackground="#252525"
                                  AlternatingRowBackground="#2A2A2A"
                                  Foreground="White"
                                  BorderBrush="Gray"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="None">

                            <DataGrid.Columns>
                                <!-- Checkbox -->
                                <DataGridTemplateColumn Header=""
                                                        Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="FeatCheckBox_Changed"
                                                      Unchecked="FeatCheckBox_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Feat Name"
                                                    Binding="{Binding Name}"
                                                    Width="220"
                                                    FontWeight="SemiBold"/>

                                <!-- FIXED: Description column with proper TextWrapping -->
                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding ShortDescription}"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping"
                                                    Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Right: Details Panel -->
                    <Border Grid.Column="1"
                            Width="420"
                            Margin="20,0,0,0"
                            Background="#1E1E1E"
                            BorderBrush="#7CFC00"
                            BorderThickness="1"
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="FEAT DETAILS"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#7CFC00"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="txtFeatDetails"
                                       Text="Select a feat from the list to see full details."
                                       Foreground="White"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>
                            <!-- Dynamic Stat Choice ComboBoxes (for feats like Shadow Touched, Athlete, etc.) -->
                            <StackPanel x:Name="pnlFeatStatChoices"
                                        Visibility="Collapsed"
                                        Margin="0,18,0,0">

                                <TextBlock x:Name="lblFeatStatChoiceHeader"
                                           Text="CHOOSE ABILITY SCORE(S) TO INCREASE"
                                           FontWeight="Bold"
                                           Foreground="#7CFC00"
                                           Margin="0,0,0,6"/>

                                <ComboBox x:Name="cmbFeatStatChoice1"
                                          Height="32"
                                          Background="#2A2A2A"
                                          Foreground="#F0F0F0"
                                          Margin="0,0,0,8"
                                          SelectionChanged="FeatStatChoice_Changed"/>

                                <ComboBox x:Name="cmbFeatStatChoice2"
                                          Height="32"
                                          Background="#2A2A2A"
                                          Foreground="#F0F0F0"
                                          Visibility="Collapsed"
                                          SelectionChanged="FeatStatChoice_Changed"/>

                                <ComboBox x:Name="cmbFeatStatChoice3"
                                          Height="32"
                                          Background="#2A2A2A"
                                          Foreground="#F0F0F0"
                                          Visibility="Collapsed"
                                          SelectionChanged="FeatStatChoice_Changed"/>

                                <ComboBox x:Name="cmbFeatStatChoice4"
                                          Height="32"
                                          Background="#2A2A2A"
                                          Foreground="#F0F0F0"
                                          Visibility="Collapsed"
                                          SelectionChanged="FeatStatChoice_Changed"/>

                            </StackPanel>
                            <!-- === FEAT SPELL PREVIEW (below combo boxes) === -->
                            <Border x:Name="brdFeatSpellPreview"
                                    Background="#1E1E1E"
                                    BorderBrush="#444"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,12,0,0"
                                    Padding="10"
                                    Visibility="Collapsed">

                                <StackPanel>
                                    <TextBlock Text="SELECTED SPELL DETAILS"
                                               FontWeight="Bold"
                                               Foreground="#7CFC00"
                                               FontSize="13"
                                               Margin="0,0,0,6"/>

                                    <TextBlock x:Name="txtFeatSpellDetails"
                                               Foreground="White"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 10: SPELLS & CANTRIPS -->
            <TabItem x:Name="tabSpells"
                     Header="10. Spells &amp; Cantrips"
                     Visibility="Collapsed">

                <StackPanel Margin="25">

                    <TextBlock x:Name="lblSpellStats"
                               Text="Spellcasting Ability: Wisdom | Spell Save DC: 13 | Spell Attack: +5"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#7CFC00"
                               Margin="0,18,0,0"/>

                    <TextBlock x:Name="lblRacialSpells"
                               Text="Racial spells: (none yet)"
                               Foreground="#AAA"
                               FontSize="12"
                               Margin="0,0,0,2"/>

                    <TextBlock x:Name="lblFeatSpells"
                               Text="Feat spells: (none yet)"
                               Foreground="#AAA"
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="lblSubclassSpells"
                               Text="Subclass spells: (none yet)"
                               Foreground="#AAA"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <!-- Totals for prepared / known (across all spell levels) -->
                    <TextBlock x:Name="lblSpellBudget"
                               Text="Spell budget: —"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#9CDCFE"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <!-- Two tables side by side -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CANTRIPS (Left) -->
                        <StackPanel>
                            <TextBlock x:Name="lblCantripHeader"
                                       Text="CANTRIPS (select up to your class limit)"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#7CFC00"
                                       Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgCantrips"
                                      AutoGenerateColumns="False"
                                      Height="340"
                                      Background="#252525"
                                      RowBackground="#252525"
                                      AlternatingRowBackground="#2A2A2A"
                                      Foreground="White"
                                      BorderBrush="#555"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      IsSynchronizedWithCurrentItem="False"
                                      SelectionChanged="dgCantrips_SelectionChanged">
                                <DataGrid.Columns>
                                    <!-- Custom Checkbox Column -->
                                    <DataGridTemplateColumn Header=""
                                                            Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding IsSelectable}"
                                                          Checked="CantripCheckBox_Changed"
                                                          Unchecked="CantripCheckBox_Changed"
                                                          PreviewMouseLeftButtonDown="SpellGridCheckBox_PreviewMouseLeftButtonDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Cantrip"
                                                        Binding="{Binding Name}"
                                                        Width="140"/>
                                    <DataGridTextColumn Header="Class"
                                                        Binding="{Binding AssignedClassDisplay}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Dice"
                                                        Binding="{Binding DamageDice}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Roll"
                                                        Binding="{Binding RollType}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding DamageType}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Range"
                                                        Binding="{Binding FullSpell.Range}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Casting Time"
                                                        Binding="{Binding FullSpell.CastingTime}"
                                                        Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="lblCantripCount"
                                       Text="Selected: 0 / 3"
                                       Foreground="White"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- LEVELED SPELLS (Right) — level filter + selection -->
                        <StackPanel Grid.Column="1"
                                    Margin="25,0,0,0">
                            <DockPanel Margin="0,0,0,8"
                                       LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Spell level:"
                                               VerticalAlignment="Center"
                                               Foreground="#CCC"
                                               Margin="0,0,8,0"/>
                                    <ComboBox x:Name="cmbSpellLevel"
                                              Width="130"
                                              Height="28"
                                              Background="#2A2A2A"
                                              Foreground="#F0F0F0"
                                              BorderBrush="#555"
                                              SelectionChanged="cmbSpellLevel_SelectionChanged"/>
                                </StackPanel>
                                <TextBlock x:Name="lblSpellHeader"
                                           Text="1ST-LEVEL SPELLS"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#7CFC00"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </DockPanel>

                            <DataGrid x:Name="dgSpells1"
                                      AutoGenerateColumns="False"
                                      Height="340"
                                      Background="#252525"
                                      RowBackground="#252525"
                                      AlternatingRowBackground="#2A2A2A"
                                      Foreground="White"
                                      BorderBrush="#555"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      IsSynchronizedWithCurrentItem="False"
                                      SelectionChanged="dgSpells1_SelectionChanged">

                                <DataGrid.Columns>
                                    <!-- Checkbox Column -->
                                    <DataGridTemplateColumn Header=""
                                                            Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding IsSelectable}"
                                                          Checked="Spell1CheckBox_Changed"
                                                          Unchecked="Spell1CheckBox_Changed"
                                                          PreviewMouseLeftButtonDown="SpellGridCheckBox_PreviewMouseLeftButtonDown"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Spell"
                                                        Binding="{Binding Name}"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="Dice"
                                                        Binding="{Binding DamageDice}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="Roll"
                                                        Binding="{Binding RollType}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding DamageType}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Range"
                                                        Binding="{Binding FullSpell.Range}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="Casting Time"
                                                        Binding="{Binding FullSpell.CastingTime}"
                                                        Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="lblSpellCount"
                                       Text="Selected this level: 0"
                                       Foreground="White"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="lblSpellTotalCount"
                                       Text="Total prepared/known: —"
                                       Foreground="#9CDCFE"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- CANTRIP PREVIEW PANEL - NOW BELOW BOTH TABLES -->
                    <Border x:Name="pnlCantripPreview"
                            Margin="0,25,0,0"
                            Background="#1E1E1E"
                            BorderBrush="#7CFC00"
                            BorderThickness="1"
                            Padding="15"
                            Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock Text="Spell Details"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#7CFC00"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="txtCantripPreview"
                                       Foreground="White"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </TabItem>

            <!-- TAB 11: SUMMARY &amp; EXPORT -->
            <TabItem x:Name="tabSummaryExport"
                     Header="11. Summary &amp; Export">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                MaxWidth="960"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                        <TextBlock Text="CHARACTER SUMMARY"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Preview of the main stats and selections that will be written to the official 5e fillable sheet."
                                   FontSize="12"
                                   Foreground="#AAA"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Preview (same calculations as Export 5e Sheet) — above export buttons -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxWidth="960"
                                  HorizontalAlignment="Center">
                        <Border Background="#252525"
                                BorderBrush="#444"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="18">
                            <StackPanel x:Name="pnlExportPreview">
                                <!-- Populated in code when this tab is selected -->
                                <TextBlock x:Name="txtSummary"
                                           Text="Open this tab after building your character to see a live preview of export values."
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="#AAA"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,4">
                        <Button Content="💾 Save Character (JSON)"
                                Click="SaveCharacter_Click"
                                Width="230"
                                Height="42"
                                Style="{StaticResource Nemo.Button.Success}"
                                Margin="8"
                                ToolTip="Save as Foundry VTT D&amp;D 5e character JSON (Import Data on a Character actor). Also reloads fully in Nemo."/>
                        <Button x:Name="btnSaveAsTemplate"
                                Content="⭐ Save as Template"
                                Click="SaveAsTemplate_Click"
                                Width="200"
                                Height="42"
                                Style="{StaticResource Nemo.Button.Primary}"
                                Margin="8"
                                ToolTip="Save this character as a reusable Custom build for Quick Generate"/>
                        <Button Content="📋 Export 5e Sheet"
                                Click="ExportOfficialSheet_Click"
                                Width="190"
                                Height="42"
                                Margin="8"
                                Style="{StaticResource Nemo.Button.Success}"
                                ToolTip="Fill the official 5e character sheet PDF with this character"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>